{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cobolcs:reference-case:1.0",
  "title": "CobolCS independent logical full-state case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "programId",
    "origin",
    "inputHashes",
    "configHash",
    "contract",
    "input",
    "expected",
    "required",
    "evidence",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "programId": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "specification",
        "cobol-reference",
        "csharp-characterization"
      ]
    },
    "inputHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "configHash": {
      "$ref": "#/$defs/hash"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/logical"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/logical"
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logical"
          }
        },
        "externalResponses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "signal": {
          "enum": [
            "goback",
            "stopRun",
            "exitProgram",
            "fallthrough"
          ]
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/logical"
          }
        },
        "externalRequests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bytes"
          }
        }
      }
    },
    "required": {
      "type": "boolean"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "syntheticDependencies",
        "conditions"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "syntheticDependencies": {
          "type": "boolean"
        },
        "syntheticCapture": {
          "type": "boolean"
        },
        "conditions": {
          "type": "object"
        },
        "referenceExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processor",
            "version",
            "compileOptions",
            "capturedAt",
            "method"
          ],
          "properties": {
            "processor": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "compileOptions": {
              "type": "string",
              "minLength": 1
            },
            "capturedAt": {
              "oneOf": [
                {
                  "const": "unknown"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "captureFiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "reviewer",
        "contentHash"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "cobol-reference"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "required": [
              "referenceExecution",
              "captureFiles",
              "syntheticCapture"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "id": {
                "const": "full-state-v1"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "fields"
            ]
          },
          "expected": {
            "required": [
              "display",
              "fields",
              "signal"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "expected": {
            "required": [
              "values",
              "signal",
              "externalRequests"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "logical": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logical"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/logical"
          }
        }
      ]
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base64",
        "length",
        "recordLengths",
        "encoding"
      ],
      "properties": {
        "base64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "recordLengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statementId",
        "kind",
        "target",
        "operation",
        "arguments",
        "query"
      ],
      "properties": {
        "statementId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "value"
            ],
            "properties": {
              "mode": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/logical"
              }
            }
          }
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "status"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "success",
                "eof",
                "no-data",
                "error",
                "invalid"
              ]
            },
            "status": {
              "type": "string"
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/logical"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/logical"
              }
            },
            "returning": {
              "$ref": "#/$defs/logical"
            },
            "record": {
              "$ref": "#/$defs/logical"
            },
            "sqlstate": {
              "type": "string",
              "minLength": 5,
              "maxLength": 5
            },
            "bytes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bytes"
              }
            }
          }
        }
      }
    }
  }
}
